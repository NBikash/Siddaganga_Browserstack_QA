# Copy to .env (setup does this automatically if .env is missing) and fill in locally.
# .env is git-ignored. Never commit it, paste its values into chat, or write them into reports.

# --- BrowserStack REST API (needed only to upload builds from the command line) ---
# Find them at https://www.browserstack.com/accounts/profile/details
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# --- Banni QA test account (needed for authenticated execution/exploration) ---
# The user types these into the device during App Live sessions; Claude never types passwords.
BANNI_QA_PHONE=
BANNI_QA_PASSWORD=

# --- App Live app references (optional; printed by `npm run upload:android` / `upload:ios`) ---
ANDROID_APP_LIVE_URL=
IOS_APP_LIVE_URL=

# --- App Automate / Appium only (NOT required for the current App Live workflow) ---
BROWSERSTACK_APP=
