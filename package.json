{
  "name": "siddaganga-browserstack-qa",
  "version": "1.0.0",
  "description": "Banni (Siddaganga Travels) QA on BrowserStack App Live - Android & iOS, driven by Claude Code. App Automate/Appium config kept but optional.",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "doctor": "node setup/doctor.mjs",
    "setup": "node setup/bootstrap.mjs",
    "upload:android": "node scripts/upload-app.js --platform android",
    "upload:ios": "node scripts/upload-app.js --platform ios",
    "upload-app": "node scripts/upload-app.js",
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --spec ./test/specs/smoke.session.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@wdio/browserstack-service": "^9.39.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "webdriverio": "^9.32.0"
  }
}
